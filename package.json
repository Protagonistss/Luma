{
  "name": "luma",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "tauri dev --config native/tauri.conf.json",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "tauri": "tauri --config native/tauri.conf.json",
    "tauri:android": "tauri android dev --config native/tauri.conf.json",
    "tauri:android:build": "tauri android build --apk --config native/tauri.conf.json"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.10",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-opener": "2.5.4",
    "hls.js": "1.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simplebar-react": "3.3.2"
  },
  "devDependencies": {
    "@ithinku/oxfmt-config": "0.1.2",
    "@ithinku/oxlint-config": "0.1.0",
    "@tauri-apps/cli": "^2.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "26.4.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  }
}
